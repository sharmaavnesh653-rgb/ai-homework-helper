---
/** Consistent page header for the workspace destinations. */
interface Props {
  overline?: string;
  title: string;
  lede?: string;
  /**
   * Match the content container below, so the heading aligns with the body
   * instead of sitting at a different left edge.
   */
  width?: 'narrow' | 'medium' | 'wide';
}

const { overline, title, lede, width = 'wide' } = Astro.props;

const widths = {
  narrow: 'max-w-3xl',
  medium: 'max-w-4xl',
  wide: 'max-w-7xl',
};
---

<header class="border-b border-line bg-surface">
  <div class:list={['mx-auto px-4 py-8 sm:px-6 sm:py-10', widths[width]]}>
    {overline && <p class="text-overline mb-2 text-brand uppercase">{overline}</p>}
    <h1 class="text-h1 text-ink">{title}</h1>
    {
      lede && (
        <p class="mt-2.5 max-w-2xl text-[15px] leading-relaxed text-ink-2">{lede}</p>
      )
    }
    <slot />
  </div>
</header>
