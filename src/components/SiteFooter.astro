---
import { GraduationCap } from 'lucide-react';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'HOME',
    links: [
      { href: '/', label: 'Home Overview' },
      { href: '/solve', label: 'Homework Solver' },
    ],
  },
  {
    heading: 'STUDY',
    links: [
      { href: '/notes', label: 'Study Notes' },
      { href: '/subjects', label: 'Subjects' },
      { href: '/practice', label: 'Practice' },
      { href: '/flashcards', label: 'Flashcards' },
      { href: '/diagrams', label: 'Diagrams' },
    ],
  },
  {
    heading: 'LIBRARY',
    links: [
      { href: '/saved', label: 'Saved Work' },
      { href: '/history', label: 'Study History' },
    ],
  },
];
---

<footer class="mt-16 border-t border-zinc-800/80 bg-zinc-950/80 text-zinc-400 text-xs">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between">
      <div class="max-w-xs space-y-3">
        <div class="flex items-center gap-2">
          <div class="grid h-7 w-7 place-items-center rounded-lg bg-emerald-600 font-extrabold text-white">
            <GraduationCap class="h-4 w-4" />
          </div>
          <span class="text-sm font-bold tracking-tight text-zinc-100">Stepwise AI</span>
        </div>
        <p class="text-xs leading-relaxed text-zinc-400">
          Student-first AI study companion built for deep understanding, step-by-step reasoning, and active recall.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          columns.map((col) => (
            <div class="space-y-2.5">
              <h4 class="text-[10px] font-mono font-bold text-zinc-500 uppercase tracking-wider">{col.heading}</h4>
              <ul class="space-y-2 font-medium">
                {col.links.map((link) => (
                  <li>
                    <a class="transition-colors hover:text-emerald-400" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-zinc-800/60 pt-6 text-[11px] font-mono text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Stepwise AI. Designed for students who want to actually learn.</p>
      <p>Explanations are AI-generated. Verify reasoning steps during revision.</p>
    </div>
  </div>
</footer>
