---
import Site from '../layouts/Site.astro';
import PageHeader from '../components/PageHeader.astro';
import DiagramsWorkspace from '../components/react/DiagramsWorkspace';
---

<Site
  title="Diagrams & Concept Maps — Stepwise"
  description="Turn complex topics into structured mindmaps, flowcharts, timelines, and visual diagrams."
>
  <PageHeader
    overline="Visual Learning"
    title="Turn complex concepts into clean visuals"
    lede="Generate mindmaps, timelines, flowcharts, and labelled diagrams for any topic in science, math, history, and literature."
  />

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
    <DiagramsWorkspace client:load />
  </div>
</Site>
