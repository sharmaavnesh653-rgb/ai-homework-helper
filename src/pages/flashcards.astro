---
import Site from '../layouts/Site.astro';
import PageHeader from '../components/PageHeader.astro';
import PracticeWorkspace from '../components/react/PracticeWorkspace';
---

<Site
  title="Flashcards & Practice — Stepwise"
  description="Flashcards and misconception-driven quizzes built so you can master any concept and recall it effortlessly."
>
  <PageHeader
    overline="Practice & Flashcards"
    title="Master any topic through active recall"
    lede="Flip through flashcards, test your understanding with quizzes, and read explanations that show why tempting wrong options are wrong."
  />

  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-10">
    <PracticeWorkspace client:load />
  </div>
</Site>
