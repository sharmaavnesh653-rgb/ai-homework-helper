---
import Site from '../layouts/Site.astro';
import PracticeWorkspace from '../components/react/PracticeWorkspace';
import { Layers } from 'lucide-react';
---

<Site
  title="Flashcards & Active Recall — Stepwise AI"
  description="Flashcards and misconception-driven quizzes built so you can master any concept and recall it effortlessly."
>
  <div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 sm:py-8 space-y-6">
    <div class="space-y-2 border-b border-zinc-800 pb-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-950/40 px-3 py-1 font-mono text-xs font-semibold text-emerald-300">
          <Layers class="h-3.5 w-3.5" />
          <span>Flashcard Decks</span>
        </span>
        <h1 class="text-xl sm:text-3xl font-extrabold tracking-tight text-zinc-100">Master Topics with Flashcards</h1>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl leading-relaxed">
        Flip through interactive flashcards, drill core formulas and definitions, then test your recall with targeted practice.
      </p>
    </div>

    <PracticeWorkspace client:load />
  </div>
</Site>
