---
import Site from '../layouts/Site.astro';
import Composer from '../components/react/Composer';
import HomeProductDemo from '../components/react/HomeProductDemo';
import { SUBJECTS } from '../lib/curriculum';
import {
  Sparkles,
  BookOpen,
  Sliders,
  HelpCircle,
  Bookmark,
  Compass,
  ArrowRight,
  CheckCircle2,
  Zap,
  ShieldCheck
} from 'lucide-react';

const QUICK_STARTERS = [
  {
    topic: 'Calculus',
    label: 'Integration by Parts',
    prompt: 'Evaluate the integral ∫ x * e^(2x) dx step by step with integration by parts formula.',
    subject: 'math',
  },
  {
    topic: 'Physics',
    label: 'Projectile Apex Height',
    prompt: 'A ball is kicked at 20 m/s at 30° above horizontal. Find the apex height and time of flight.',
    subject: 'physics',
  },
  {
    topic: 'Chemistry',
    label: 'Stoichiometry & Moles',
    prompt: 'How many grams of CO2 are produced when 50g of CaCO3 reacts with excess HCl?',
    subject: 'chemistry',
  },
  {
    topic: 'History',
    label: 'Causes of WWI',
    prompt: 'Explain the alliance system and assassination of Archduke Franz Ferdinand as catalysts for WWI.',
    subject: 'history',
  },
];

const FEATURES = [
  {
    icon: Sparkles,
    title: 'Structured Reasoning Solver',
    desc: 'Get structured step-by-step derivations with rendered formulas and conceptual explanations — not just a raw answer.',
    href: '/solve',
  },
  {
    icon: BookOpen,
    title: 'Textbook Chapter Notes',
    desc: 'Select your class, subject, and chapter to generate revision summaries, key definitions, and anchored Q&A chat.',
    href: '/notes',
  },
  {
    icon: Sliders,
    title: 'Visual Concept Maps',
    desc: 'Transform dense topics into visual flowcharts, labelled diagrams, and timelines for deeper intuition.',
    href: '/diagrams',
  },
  {
    icon: HelpCircle,
    title: 'Misconception Quizzes',
    desc: 'Drill active recall flashcards and quizzes where explanations target the exact mistake behind wrong options.',
    href: '/practice',
  },
];
---

<Site
  title="Stepwise AI — Understand your homework, not just the answer"
  description="Student-first AI study workspace with structured step-by-step reasoning, chapter notes, visual concept maps, and practice."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12 space-y-16">
    
    {/* HERO SECTION */}
    <section class="space-y-8 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-950/40 px-3.5 py-1 text-xs font-semibold text-emerald-300">
        <Sparkles class="h-3.5 w-3.5 text-emerald-400" />
        <span>Student-First AI Workspace</span>
      </div>

      <div class="space-y-4">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-zinc-100 leading-tight">
          Understand your homework, <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-500 bg-clip-text text-transparent">
            not just the answer.
          </span>
        </h1>

        <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-2xl mx-auto">
          Stepwise breaks down complex problems into step-by-step reasoning, formulas, visual concept maps, and active-recall practice.
        </p>
      </div>

      {/* Hero Quick-Start Example Chips */}
      <div class="pt-2">
        <span class="text-[11px] font-mono uppercase tracking-wider font-bold text-zinc-500 block mb-3">
          Instant Example Starters:
        </span>
        <div class="flex flex-wrap justify-center gap-2">
          {
            QUICK_STARTERS.map((item) => (
              <a
                href={`/solve?question=${encodeURIComponent(item.prompt)}&subject=${item.subject}`}
                class="inline-flex items-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-900/80 px-3.5 py-1.5 text-xs font-medium text-zinc-300 transition-all hover:border-emerald-500/50 hover:bg-emerald-950/30 hover:text-emerald-300"
              >
                <span class="text-emerald-400 font-mono font-bold text-[11px]">{item.topic}:</span>
                <span>{item.label}</span>
                <ArrowRight class="h-3 w-3 text-zinc-500" />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* CORE COMPOSER INPUT EXPERIENCE */}
    <section class="max-w-3xl mx-auto">
      <Composer client:load showInputHints showExamples />
    </section>

    {/* INTERACTIVE PRODUCT DEMO WINDOW */}
    <section class="space-y-4">
      <div class="text-center space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-100">
          How Stepwise Works — Interactive Product Preview
        </h2>
        <p class="text-xs sm:text-sm text-zinc-400">
          Click through the 5 steps to see how questions transform into deep conceptual mastery.
        </p>
      </div>

      <HomeProductDemo client:load />
    </section>

    {/* FEATURE CARDS GRID */}
    <section class="space-y-6 pt-6 border-t border-zinc-800/80">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-100">
            Four Core Tools Built For Real Study
          </h2>
          <p class="text-xs sm:text-sm text-zinc-400 mt-1">
            Everything you need for STEM and Humanities coursework in one place.
          </p>
        </div>
        
        <a
          href="/solve"
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-500 transition-all"
        >
          <span>Open Solver Workspace</span>
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          FEATURES.map((feat) => {
            const Icon = feat.icon;
            return (
              <a
                href={feat.href}
                class="group flex flex-col justify-between rounded-2xl border border-zinc-800/80 bg-zinc-900/40 p-5 transition-all hover:border-emerald-500/40 hover:bg-zinc-900/90"
              >
                <div class="space-y-3">
                  <div class="grid h-10 w-10 place-items-center rounded-xl bg-emerald-950/80 border border-emerald-500/30 text-emerald-400 group-hover:scale-105 transition-transform">
                    <Icon class="h-5 w-5" />
                  </div>
                  <h3 class="text-sm font-bold text-zinc-100 group-hover:text-emerald-400 transition-colors">
                    {feat.title}
                  </h3>
                  <p class="text-xs leading-relaxed text-zinc-400">
                    {feat.desc}
                  </p>
                </div>

                <div class="pt-4 flex items-center gap-1 text-xs font-semibold text-emerald-400">
                  <span>Explore tool</span>
                  <ArrowRight class="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" />
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

  </div>
</Site>
