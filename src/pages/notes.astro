---
import Site from '../layouts/Site.astro';
import NotesWorkspace from '../components/react/NotesWorkspace';
import { BookOpen } from 'lucide-react';
---

<Site
  title="Study Notes & Textbook Chat — Stepwise AI"
  description="Select your class, subject, textbook, and chapter to generate revision notes and ask questions anchored specifically to that chapter."
>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 space-y-6">
    <div class="space-y-2 border-b border-zinc-800 pb-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-950/40 px-3 py-1 font-mono text-xs font-semibold text-emerald-300">
          <BookOpen class="h-3.5 w-3.5" />
          <span>Notes Workspace</span>
        </span>
        <h1 class="text-xl sm:text-3xl font-extrabold tracking-tight text-zinc-100">Study Notes & Textbook Chat</h1>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl leading-relaxed">
        Select class, subject, textbook, and chapter to generate structured revision summaries and ask questions anchored to that chapter.
      </p>
    </div>

    <NotesWorkspace client:load />
  </div>
</Site>
