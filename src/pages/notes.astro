---
import Site from '../layouts/Site.astro';
import PageHeader from '../components/PageHeader.astro';
import NotesWorkspace from '../components/react/NotesWorkspace';
---

<Site
  title="Study notes — Stepwise"
  description="Pick your class, subject, textbook and chapter to generate structured revision notes — then ask questions about that exact chapter without losing context."
>
  <PageHeader
    overline="Study notes"
    title="Notes for the chapter you're actually on"
    lede="Choose your class, subject, textbook and chapter. You get key points, definitions, formulas, likely test questions and a revision checklist — plus a chat that stays anchored to that chapter."
  />

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10">
    <NotesWorkspace client:load />
  </div>
</Site>
