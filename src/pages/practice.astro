---
import Site from '../layouts/Site.astro';
import PracticeWorkspace from '../components/react/PracticeWorkspace';
import { HelpCircle } from 'lucide-react';
---

<Site
  title="Practice & Misconception Quizzes — Stepwise AI"
  description="Flashcards for recall, then a quiz where every explanation covers the exact misconception behind tempting wrong options."
>
  <div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 sm:py-8 space-y-6">
    <div class="space-y-2 border-b border-zinc-800 pb-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-950/40 px-3 py-1 font-mono text-xs font-semibold text-emerald-300">
          <HelpCircle class="h-3.5 w-3.5" />
          <span>Active Recall</span>
        </span>
        <h1 class="text-xl sm:text-3xl font-extrabold tracking-tight text-zinc-100">Practice & Misconception Quizzes</h1>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl leading-relaxed">
        Flashcards for active recall, then quizzes where explanations target the exact misconception behind tempting wrong options.
      </p>
    </div>

    <PracticeWorkspace client:load />
  </div>
</Site>
