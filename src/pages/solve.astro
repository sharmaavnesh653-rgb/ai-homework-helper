---
import Site from '../layouts/Site.astro';
import SolveWorkspace from '../components/react/SolveWorkspace';
import { Sparkles } from 'lucide-react';
---

<Site
  title="Homework Solver Workspace — Stepwise AI"
  description="Ask a homework question, paste text, or upload a photo or PDF worksheet. Get structured step-by-step reasoning with rendered KaTeX formulas and visual diagrams."
>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 space-y-6">
    <div class="space-y-2 border-b border-zinc-800 pb-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-950/40 px-3 py-1 font-mono text-xs font-semibold text-emerald-300">
          <Sparkles class="h-3.5 w-3.5" />
          <span>Core Solver Workspace</span>
        </span>
        <h1 class="text-xl sm:text-3xl font-extrabold tracking-tight text-zinc-100">Homework Solver</h1>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl leading-relaxed">
        Type it, paste text, or upload a photo of a page or PDF worksheet. Choose a single hint, full walkthrough, or a check of your attempt.
      </p>
    </div>

    <SolveWorkspace client:load />
  </div>
</Site>
